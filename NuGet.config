<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  WHERE SignalCraft COMES FROM
  ============================================================================
  A block in this library derives from BlockBase and implements IHostedBlock,
  both of which live in SignalCraft.Hosting. The NuGet half of this repository
  therefore needs that package to compile.

  SignalCraft is not published. There is nowhere to publish it to yet, so its
  packages are built locally and eng/sync-sdk.ps1 copies the one this library
  needs into artifacts/nuget below.

  WITHOUT THIS FILE THE LIBRARY DID NOT BUILD AT ALL. A restore asked
  nuget.org for SignalCraft.Hosting, got NU1101, and stopped. That was true
  from the first commit and stayed true because nothing here had been built
  since - which is the argument for the csproj being exercised by something,
  not merely published.

  WHEN SignalCraft IS PUBLISHED, delete the `signalcraft-local` line and the
  packageSourceMapping entry beside it. Nothing else changes: not the csproj,
  not the version, not a using.

  THE FOLDER MUST EXIST, EVEN EMPTY. NuGet treats a local source that does not
  exist as an error - NU1301, "the local source ... doesn't exist" - and fails
  the restore before a single project compiles, rather than treating it as a
  source with nothing in it. artifacts/nuget/.gitkeep is tracked so the folder
  exists from checkout; .gitignore keeps the .nupkg files out.
  ============================================================================
-->
<configuration>
  <packageSources>
    <!-- `clear` first. Without it a machine-level NuGet.config can inject
         sources this repository never asked for, and "it restores on mine"
         comes to depend on a file nobody here can see. -->
    <clear />
    <add key="signalcraft-local" value="artifacts/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- SignalCraft.* may ONLY come from the local feed, and never from
       nuget.org. Without this, a missing local package silently falls through
       to the public gallery, where the name is unclaimed - which is how a
       supply-chain substitution happens in a repository that thought it was
       pinned. -->
  <packageSourceMapping>
    <packageSource key="signalcraft-local">
      <package pattern="SignalCraft.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
